{
  "name": "transpack-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "format": "oxfmt",
    "map": "node scripts/generate-world-map.mjs src/data/worldMap.ts",
    "email:header": "node scripts/generate-email-header.mjs",
    "advisor:token": "node scripts/zoho-token.mjs",
    "advisor:check": "node scripts/zoho-advisor-check.mjs",
    "brevo:events": "node scripts/brevo-events.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:security": "vitest run tests/security",
    "test:e2e": "playwright test",
    "test:deps": "pnpm audit --audit-level=high",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm test:seo",
    "check:all": "pnpm check && pnpm test:deps && pnpm test:e2e",
    "test:ga": "GA_E2E=1 playwright test tests/e2e/analytics.spec.ts",
    "test:seo": "SEO_DIST=1 vitest run"
  },
  "dependencies": {
    "bootstrap-icons": "^1.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "d3-geo": "^3.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "oxfmt": "^0.72.0",
    "tailwindcss": "^4.0.0",
    "topojson-client": "^3.1.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "world-atlas": "^2.0.2"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  }
}
