# Variables de entorno del sitio.
# · Las que empiezan por VITE_ son PÚBLICAS: quedan visibles en el navegador.
# · Las del formulario (BREVO_API_KEY, LEADS_*) son del SERVIDOR: solo las lee la
#   función api/contact.mts. La clave de Brevo nunca debe llevar el prefijo VITE_.
#
# Copie este archivo como ".env.production.local" (solo lo usa `pnpm build`;
# `pnpm dev` no envía datos) o configure las variables en
# Vercel → Project Settings → Environment Variables (entorno Production).

# ID de medición de Google Analytics 4 (formato G-XXXXXXXXXX). Se obtiene en:
# analytics.google.com → Administrar → Flujos de datos → Web → "ID de medición".
# Si se deja vacío (o es el ejemplo G-XXXXXXXXXX), Google Analytics no se carga
# y no aparece el aviso de cookies.
VITE_GA_MEASUREMENT_ID=

# SEO (ver docs/seo.md)
# "true" SOLO cuando www.transpacksas.com apunte a este sitio: quita el noindex,
# abre robots.txt y publica el sitemap. Configurarlo en Vercel (entorno Production)
# y volver a desplegar.
VITE_SITE_INDEXABLE=
# Opcional: código de verificación de Google Search Console (método "etiqueta HTML").
# Si verifica el dominio por DNS (recomendado), déjelo vacío.
VITE_GOOGLE_SITE_VERIFICATION=

# ─── Formularios: envío de solicitudes por correo (ver docs/formularios.md) ───
# Solo en Vercel → Settings → Environment Variables (entorno Production). En
# `pnpm dev` el envío se simula y no se necesita ninguna.
# Clave de API de Brevo (SMTP & API → API Keys). SECRETA. Sin ella, la función
# responde "not-configured" y el formulario ofrece WhatsApp.
BREVO_API_KEY=
# Correo que recibe el formulario de contacto (por defecto servicioalcliente@transpacksas.com)
LEADS_TO=
# Correo que recibe las solicitudes de cotización: cotizador y formulario con
# motivo "Cotización" (por defecto mercadeo@transpacksas.com)
LEADS_TO_QUOTES=
# Remitente verificado en Brevo (por defecto no-reply@transpacksas.com)
LEADS_FROM=
# Nombre del remitente (por defecto "Transpack")
LEADS_FROM_NAME=

# ─── Chat con un asesor dentro de Joel (Zoho SalesIQ, ver docs/chat-crm.md) ───
# Solo en Vercel (Production) y, para probar en este equipo, en .env.local
# (NO versionado). SECRETAS: nunca con prefijo VITE_. Sin ellas, "Chatear con un
# asesor" abre la ventana de Zoho como antes.
# Self Client de https://api-console.zoho.com con los alcances
# SalesIQ.conversations.CREATE, SalesIQ.conversations.READ, SalesIQ.Apps.READ y
# SalesIQ.departments.READ.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Clave larga y aleatoria para firmar el acceso a cada conversación
# (por ejemplo: openssl rand -base64 48)
ADVISOR_SECRET=
# Nombre del portal en la dirección de SalesIQ (por defecto transpacksas)
ZOHO_SALESIQ_SCREEN=
# Opcionales: si faltan se usan la primera marca y el primer departamento
# (pnpm advisor:check los muestra)
ZOHO_SALESIQ_APP_ID=
ZOHO_SALESIQ_DEPARTMENT_ID=
# Centro de datos de Zoho (por defecto el de .com)
ZOHO_ACCOUNTS_URL=
ZOHO_SALESIQ_URL=
